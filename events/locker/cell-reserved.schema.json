{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kite.ua/events/locker/cell-reserved/v1.json",
  "title": "LockerCellReservedData",
  "description": "Комірку закріплено за відправленням або камерою зберігання.",
  "type": "object",
  "required": [
    "lockerId",
    "locationId",
    "cellCode",
    "size",
    "expiresAt"
  ],
  "properties": {
    "lockerId": {
      "type": "string",
      "format": "uuid"
    },
    "locationId": {
      "type": "string",
      "format": "uuid"
    },
    "cellCode": {
      "type": "string",
      "description": "Код комірки {код поштомату}-{A01} (10.1)"
    },
    "size": {
      "$ref": "api.schema.json#/$defs/CellSize"
    },
    "shipmentId": {
      "type": "string",
      "format": "uuid"
    },
    "bookingId": {
      "type": "string",
      "format": "uuid",
      "description": "Якщо це камера зберігання"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
