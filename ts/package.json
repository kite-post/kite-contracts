{
  "name": "@kite-post/contracts",
  "version": "0.3.0",
  "description": "Типи REST-контракту і подій Kite та клієнт API, згенеровані з kite-contracts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kite-post/kite-contracts.git",
    "directory": "ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "openapi-typescript ../build/kite-contracts.openapi.json --output src/schema.gen.ts --root-types --root-types-no-schema-prefix --enum-values --alphabetize",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test/"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3"
  }
}
